{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pas.cross-sdl-extraction.v1",
  "title": "Evidence-grounded Cross-SDL Extraction",
  "type": "object",
  "required": [
    "scientific_knowledge",
    "research_strategy",
    "transferable_pattern"
  ],
  "properties": {
    "scientific_knowledge": {
      "type": "object",
      "required": ["hypothesis", "mechanism", "evidence", "conclusion"],
      "properties": {
        "hypothesis": {"$ref": "#/$defs/groundedText"},
        "mechanism": {"$ref": "#/$defs/groundedText"},
        "evidence": {"$ref": "#/$defs/groundedText"},
        "conclusion": {"$ref": "#/$defs/groundedText"}
      },
      "additionalProperties": false
    },
    "research_strategy": {
      "type": "object",
      "required": [
        "problem_type",
        "strategy",
        "strategy_role",
        "trigger",
        "objective",
        "constraints",
        "exploration_policy",
        "stopping_rule",
        "decision",
        "outcome"
      ],
      "properties": {
        "problem_type": {"$ref": "#/$defs/groundedResearchGoal"},
        "strategy": {"$ref": "#/$defs/groundedStrategy"},
        "strategy_role": {"$ref": "#/$defs/groundedText"},
        "trigger": {"$ref": "#/$defs/groundedText"},
        "objective": {"$ref": "#/$defs/groundedText"},
        "constraints": {
          "type": "array",
          "items": {"$ref": "#/$defs/groundedContextCondition"}
        },
        "exploration_policy": {"$ref": "#/$defs/groundedText"},
        "stopping_rule": {"$ref": "#/$defs/groundedText"},
        "decision": {"$ref": "#/$defs/groundedDecisionOperator"},
        "outcome": {"$ref": "#/$defs/groundedText"}
      },
      "additionalProperties": false
    },
    "transferable_pattern": {
      "type": "object",
      "required": [
        "source_domain",
        "target_capability",
        "required_conditions",
        "failure_conditions",
        "transfer_level",
        "transfer_confidence"
      ],
      "properties": {
        "source_domain": {"$ref": "#/$defs/groundedText"},
        "target_capability": {"$ref": "#/$defs/groundedText"},
        "required_conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/groundedContextCondition"}
        },
        "failure_conditions": {
          "type": "array",
          "items": {"$ref": "#/$defs/groundedContextCondition"}
        },
        "transfer_level": {"$ref": "#/$defs/groundedTransferLevel"},
        "transfer_confidence": {"$ref": "#/$defs/groundedConfidence"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidenceSpans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "paper_id",
          "chunk_id",
          "evidence_type",
          "text_span",
          "start_offset",
          "end_offset"
        ],
        "properties": {
          "paper_id": {"type": "string"},
          "chunk_id": {"type": "string"},
          "evidence_type": {"type": "string"},
          "text_span": {"type": "string"},
          "start_offset": {"type": "integer", "minimum": 0},
          "end_offset": {"type": "integer", "minimum": 0},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "additionalProperties": false
      }
    },
    "groundedText": {
      "type": ["object", "null"],
      "required": ["value", "evidence_spans"],
      "properties": {
        "value": {"type": ["string", "null"]},
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"}
      },
      "additionalProperties": false
    },
    "groundedResearchGoal": {
      "type": ["object", "null"],
      "required": [
        "ontology_layer",
        "canonical_concept",
        "surface_form",
        "evidence_spans"
      ],
      "properties": {
        "ontology_layer": {"enum": ["research_goals"]},
        "canonical_concept": {"type": ["string", "null"]},
        "surface_form": {"type": ["string", "null"]},
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"}
      },
      "additionalProperties": false
    },
    "groundedStrategy": {
      "type": ["object", "null"],
      "required": [
        "ontology_layer",
        "canonical_concept",
        "surface_form",
        "evidence_spans"
      ],
      "properties": {
        "ontology_layer": {"enum": ["strategy_concepts"]},
        "canonical_concept": {"type": ["string", "null"]},
        "surface_form": {"type": ["string", "null"]},
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"}
      },
      "additionalProperties": false
    },
    "groundedDecisionOperator": {
      "type": ["object", "null"],
      "required": [
        "ontology_layer",
        "canonical_concept",
        "surface_form",
        "evidence_spans"
      ],
      "properties": {
        "ontology_layer": {"enum": ["decision_operators"]},
        "canonical_concept": {"type": ["string", "null"]},
        "surface_form": {"type": ["string", "null"]},
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"}
      },
      "additionalProperties": false
    },
    "groundedContextCondition": {
      "type": ["object", "null"],
      "required": [
        "ontology_layer",
        "canonical_concept",
        "surface_form",
        "evidence_spans"
      ],
      "properties": {
        "ontology_layer": {"enum": ["context_conditions"]},
        "canonical_concept": {"type": ["string", "null"]},
        "surface_form": {"type": ["string", "null"]},
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"}
      },
      "additionalProperties": false
    },
    "groundedTransferLevel": {
      "type": ["object", "null"],
      "required": ["value", "evidence_spans"],
      "properties": {
        "value": {
          "enum": ["algorithm", "workflow", "representation", "mechanism", null]
        },
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"}
      },
      "additionalProperties": false
    },
    "groundedConfidence": {
      "type": ["object", "null"],
      "required": ["value", "method", "evidence_spans", "assumptions"],
      "properties": {
        "value": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "method": {"type": "string"},
        "evidence_spans": {"$ref": "#/$defs/evidenceSpans"},
        "assumptions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
