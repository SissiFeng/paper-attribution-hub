{
  "name": "PAS research workspace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/aws-cli:1": {}
  },
  "hostRequirements": { "cpus": 2, "memory": "8gb", "storage": "32gb" },
  "remoteUser": "vscode",
  "postCreateCommand": "bash scripts/cloud/setup.sh",
  "forwardPorts": [8877],
  "portsAttributes": {
    "8877": { "label": "PAS private development preview", "onAutoForward": "notify", "visibility": "private" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "openai.chatgpt"],
      "settings": { "python.defaultInterpreterPath": "${workspaceFolder}/backend/.venv/bin/python" }
    }
  }
}
