{
  "$defs": {
    "MpuInputSource": {
      "additionalProperties": false,
      "properties": {
        "path_hint": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Path Hint",
          "type": "string"
        },
        "role": {
          "enum": [
            "base_study",
            "counterfactual_cases",
            "curated_task_source"
          ],
          "title": "Role",
          "type": "string"
        },
        "schema_version": {
          "const": "evidence-following-mpu-input-source-v0.1",
          "default": "evidence-following-mpu-input-source-v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "role",
        "sha256",
        "path_hint"
      ],
      "title": "MpuInputSource",
      "type": "object"
    },
    "MpuModel": {
      "additionalProperties": false,
      "properties": {
        "alias": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Alias",
          "type": "string"
        },
        "family": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Family",
          "type": "string"
        },
        "model_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Model Id",
          "type": "string"
        },
        "schema_version": {
          "const": "evidence-following-mpu-model-v0.1",
          "default": "evidence-following-mpu-model-v0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "alias",
        "family",
        "model_id"
      ],
      "title": "MpuModel",
      "type": "object"
    },
    "MpuPaper": {
      "additionalProperties": false,
      "properties": {
        "doi": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Doi",
          "type": "string"
        },
        "domain": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "paper_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "report_type": {
          "enum": [
            "primary_experiment",
            "review",
            "case_study",
            "unknown"
          ],
          "title": "Report Type",
          "type": "string"
        },
        "schema_version": {
          "const": "evidence-following-mpu-paper-v0.1",
          "default": "evidence-following-mpu-paper-v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_markdown_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Markdown Sha256",
          "type": "string"
        },
        "title": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "paper_id",
        "domain",
        "title",
        "doi",
        "report_type",
        "source_markdown_sha256"
      ],
      "title": "MpuPaper",
      "type": "object"
    },
    "MpuPolicy": {
      "additionalProperties": false,
      "properties": {
        "bootstrap_replicates": {
          "default": 2000,
          "maximum": 10000,
          "minimum": 100,
          "title": "Bootstrap Replicates",
          "type": "integer"
        },
        "bootstrap_seed": {
          "default": 20260901,
          "minimum": 0,
          "title": "Bootstrap Seed",
          "type": "integer"
        },
        "correlation_equivalence_bound": {
          "default": 0.3,
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "title": "Correlation Equivalence Bound",
          "type": "number"
        },
        "max_mean_cross_domain_gap": {
          "default": 0.1,
          "maximum": 1,
          "minimum": 0,
          "title": "Max Mean Cross Domain Gap",
          "type": "number"
        },
        "min_model_count": {
          "default": 3,
          "minimum": 2,
          "title": "Min Model Count",
          "type": "integer"
        },
        "min_primary_papers_per_domain": {
          "default": 100,
          "minimum": 1,
          "title": "Min Primary Papers Per Domain",
          "type": "integer"
        },
        "min_tasks_per_domain": {
          "default": 100,
          "minimum": 1,
          "title": "Min Tasks Per Domain",
          "type": "integer"
        },
        "schema_version": {
          "const": "evidence-following-mpu-policy-v0.1",
          "default": "evidence-following-mpu-policy-v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "trait_rank_correlation_threshold": {
          "default": 0.6,
          "maximum": 1,
          "minimum": -1,
          "title": "Trait Rank Correlation Threshold",
          "type": "number"
        }
      },
      "title": "MpuPolicy",
      "type": "object"
    },
    "MpuTask": {
      "additionalProperties": false,
      "properties": {
        "blind_context": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Blind Context",
          "type": "string"
        },
        "counterfactual_evidence": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Counterfactual Evidence",
          "type": "string"
        },
        "domain": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Domain",
          "type": "string"
        },
        "fact_injection": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Fact Injection",
          "type": "string"
        },
        "field_type": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Field Type",
          "type": "string"
        },
        "original_value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Original Value",
          "type": "string"
        },
        "paper_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Paper Id",
          "type": "string"
        },
        "paper_identity": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Paper Identity",
          "type": "string"
        },
        "question": {
          "maxLength": 5000,
          "minLength": 1,
          "title": "Question",
          "type": "string"
        },
        "replacement_value": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Replacement Value",
          "type": "string"
        },
        "schema_version": {
          "const": "evidence-following-mpu-task-v0.1",
          "default": "evidence-following-mpu-task-v0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_evidence_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Source Evidence Sha256",
          "type": "string"
        },
        "task_id": {
          "maxLength": 500,
          "minLength": 1,
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "paper_id",
        "domain",
        "field_type",
        "question",
        "paper_identity",
        "blind_context",
        "original_value",
        "replacement_value",
        "counterfactual_evidence",
        "fact_injection",
        "source_evidence_sha256"
      ],
      "title": "MpuTask",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "domains": {
      "items": {
        "type": "string"
      },
      "maxItems": 2,
      "title": "Domains",
      "type": "array"
    },
    "input_sources": {
      "items": {
        "$ref": "#/$defs/MpuInputSource"
      },
      "maxItems": 100,
      "title": "Input Sources",
      "type": "array"
    },
    "models": {
      "items": {
        "$ref": "#/$defs/MpuModel"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Models",
      "type": "array"
    },
    "papers": {
      "items": {
        "$ref": "#/$defs/MpuPaper"
      },
      "maxItems": 500,
      "title": "Papers",
      "type": "array"
    },
    "policy": {
      "$ref": "#/$defs/MpuPolicy"
    },
    "schema_version": {
      "const": "evidence-following-mpu-study-v0.1",
      "default": "evidence-following-mpu-study-v0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "study_id": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Study Id",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/MpuTask"
      },
      "maxItems": 5000,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "study_id",
    "domains",
    "models"
  ],
  "title": "MpuStudyInput",
  "type": "object"
}
