# Copy to .env and fill in your values.
# All variables use the PAS_ prefix (pydantic-settings).

# PostgreSQL connection string from Supabase (Transaction pooler, port 6543)
PAS_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Comma-separated list of allowed frontend origins
PAS_CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:5173"]

# Optional: OpenAlex polite-pool email (improves rate limits)
PAS_OPENALEX_MAILTO=you@example.com

# Optional: Semantic Scholar API key
PAS_SEMANTIC_SCHOLAR_API_KEY=

# Optional: GROBID service URL (leave empty to use PyMuPDF)
PAS_GROBID_URL=
