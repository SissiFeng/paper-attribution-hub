# Copy to .env and fill in your values.
# All variables use the PAS_ prefix (pydantic-settings).

# Local PostgreSQL; AWS ECS receives the RDS URL from Secrets Manager.
PAS_DATABASE_URL=postgresql://pas:pas@localhost:5432/paper_attribution

# Comma-separated list of allowed frontend origins
PAS_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
# AWS: set this to the deployed CloudFront origin or your configured domain.

# Optional: OpenAlex polite-pool email (improves rate limits)
PAS_OPENALEX_MAILTO=you@example.com
# Optional: free OpenAlex key for a larger daily API budget
PAS_OPENALEX_API_KEY=

# Optional: Semantic Scholar API key
PAS_SEMANTIC_SCHOLAR_API_KEY=

# Optional: GROBID service URL (leave empty to use PyMuPDF)
PAS_GROBID_URL=

# Authoritative Zotero group library. Prefer immutable collection keys over names.
PAS_ZOTERO_API_KEY=
PAS_ZOTERO_GROUP_ID=
PAS_ZOTERO_TIER1_COLLECTION=
PAS_ZOTERO_TIER2_COLLECTION=
PAS_ZOTERO_SYNC_ON_STARTUP=false
PAS_ZOTERO_DOWNLOAD_FULLTEXTS=false
PAS_ZOTERO_SOURCE_ONLY=true
PAS_SDL_STAGE1_ONLY=false
PAS_SDL_STAGE1_TRAINING_THROUGH_ROUND=0
PAS_SDL_STAGE1_DERIVED_VIEWS_ENABLED=false
PAS_SDL_STAGE1_DESCRIPTIVE_ANALYTICS_ENABLED=false

# Generated, non-authoritative wiki cache. Use a durable mounted path in production.
PAS_LLM_WIKI_ROOT=../llm-wiki

# Optional key for mutating endpoints; clients send it as X-API-Key.
PAS_API_KEY=

# AWS backup/full-text artifact destination.
PAS_S3_ARTIFACTS_BUCKET=
PAS_AWS_REGION=ca-central-1

# Set only after backup_database_to_s3 prints a verified backup reference.
PAS_CORPUS_BACKUP_REFERENCE=
