[
  {
    "name": "backend",
    "image": "PLACEHOLDER_ECR_REPO:PLACEHOLDER_TAG",
    "essential": true,
    "portMappings": [
      {
        "containerPort": 8000,
        "protocol": "tcp"
      }
    ],
    "environment": [
      { "name": "PAS_DATABASE_URL", "value": "PLACEHOLDER_DATABASE_URL" },
      { "name": "PAS_CORS_ORIGINS", "value": "[\"http://localhost:5173\"]" },
      { "name": "PAS_S3_ARTIFACTS_BUCKET", "value": "PLACEHOLDER_ARTIFACTS_BUCKET" },
      { "name": "PAS_AWS_REGION", "value": "us-east-1" }
    ],
    "secrets": [
      { "name": "PAS_ANTHROPIC_API_KEY", "valueFrom": "PLACEHOLDER_ANTHROPIC_KEY_ARN" },
      { "name": "PAS_KIMI_API_KEY", "valueFrom": "PLACEHOLDER_KIMI_KEY_ARN" },
      { "name": "PAS_SEMANTIC_SCHOLAR_API_KEY", "valueFrom": "PLACEHOLDER_SS_KEY_ARN" },
      { "name": "PAS_OPENALEX_MAILTO", "valueFrom": "PLACEHOLDER_OPENALEX_ARN" }
    ],
    "logConfiguration": {
      "logDriver": "awslogs",
      "options": {
        "awslogs-group": "PLACEHOLDER_LOG_GROUP",
        "awslogs-region": "us-east-1",
        "awslogs-stream-prefix": "backend"
      }
    },
    "healthCheck": {
      "command": ["CMD-SHELL", "curl -f http://localhost:8000/health || exit 1"],
      "interval": 30,
      "timeout": 5,
      "retries": 3,
      "startPeriod": 120
    }
  }
]
