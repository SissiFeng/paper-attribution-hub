{
  "rewrites": [
    {
      "source": "/api/preview/papers/:paperId/attribution-evidence-tree",
      "destination": "https://paper-attribution-api.onrender.com/papers/:paperId/attribution-evidence-tree"
    },
    {
      "source": "/api/preview/papers/:paperId",
      "destination": "https://paper-attribution-api.onrender.com/papers/:paperId"
    },
    {
      "source": "/api/preview/papers",
      "destination": "https://paper-attribution-api.onrender.com/papers"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install"
}
