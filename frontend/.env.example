# Copy to .env.local and fill in your values.

# Backend API base URL (no trailing slash)
# Local dev:
VITE_API_BASE=http://localhost:8000
# AWS production (CloudFront routes /api to the backend):
# VITE_API_BASE=/api

# Set to "true" to use built-in mock data (no backend required)
VITE_USE_MOCK=false
