{
  "name": "pas-remotion-story",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "capture": "node scripts/capture-story.mjs",
    "studio": "remotion studio src/index.ts --props=data/visual-story.demo.json",
    "test:capture": "node --test scripts/capture-story.test.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "node scripts/validate-story.mjs data/visual-story.demo.json",
    "render": "node scripts/render.mjs",
    "render:checkpoints": "node scripts/render-checkpoints.mjs",
    "verify:frames": "node scripts/verify-frames.mjs"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.507"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.507",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "typescript": "5.5.4"
  }
}
